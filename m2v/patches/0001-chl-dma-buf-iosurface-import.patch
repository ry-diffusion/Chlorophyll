+/// Chlorophyll: a stage's linked functions (RenderBox's `custom_fn`) from the descriptor's list.
+fn linked_functions(list: *const *mut NmbFunction, count: usize) -> Result<metal2vulkan::pipeline::LinkedFunctions, String> {
