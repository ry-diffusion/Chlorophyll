+  if(b.shadowOf && ![live containsObject:b])[live addObject:b];
+ }
+ for(NBBuffer *b in live){
+  // backboardd's no-copy buffers can outlive their memory (a client's shared memory, unmapped): copy through the kernel, which
+  // answers an error instead of a fault, and stop refreshing a buffer whose memory is gone
+  // one region lookup says whether the caller's range is still mapped and readable, then a plain copy (vm_read_overwrite
+  // through the kernel was 13 % of backboardd's display thread)
+  const vm_size_t length=(vm_size_t)nmb_buffer_length(b.handle);
+  // the range may span several adjacent regions (a framebuffer-sized mapping did): walk them until it is covered
+  kern_return_t kr=KERN_SUCCESS;
+  for(vm_address_t at=(vm_address_t)b.shadowOf,end=at+length;at<end && kr==KERN_SUCCESS;) {
+   vm_address_t region=at;vm_size_t regionSize=0;
+   vm_region_basic_info_data_64_t info;mach_msg_type_number_t infoCount=VM_REGION_BASIC_INFO_COUNT_64;mach_port_t object=MACH_PORT_NULL;
+   kr=vm_region_64(mach_task_self(),&region,&regionSize,VM_REGION_BASIC_INFO_64,(vm_region_info_t)&info,&infoCount,&object);
+   if(kr==KERN_SUCCESS && (region>at || !(info.protection&VM_PROT_READ)))kr=KERN_INVALID_ADDRESS;
+   at=region+regionSize;
+  }
+  if(kr==KERN_SUCCESS){memcpy(nmb_buffer_contents(b.handle),b.shadowOf,length);gChlShadowBytes+=length;}
+  if(kr!=KERN_SUCCESS){
+   {std::lock_guard<std::mutex> lock(gShadowLock);[gShadows removeObject:b];}
+   b.shadowOf=nullptr;   // contents falls back to the GPU memory
+   static std::atomic<int> said{0};
+   if(said++<10)NBLOG(@"chl: no-copy shadow %p (%llu bytes): its memory is gone (kr %d), no longer refreshed",b.shadowOf,(unsigned long long)nmb_buffer_length(b.handle),kr);
+  }
